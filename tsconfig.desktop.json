{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "types": ["node", "vite/client"]
  },
  "include": [
    "desktop/**/*.tsx",
    "app/components/**/*.tsx",
    "components/**/*.tsx",
    "lib/**/*.ts",
    "vite.desktop.config.ts"
  ],
  "exclude": ["node_modules", "dist", "desktop-dist", "release", "worker", "db"]
}
